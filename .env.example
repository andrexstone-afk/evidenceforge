# Never place real keys or patient-identifiable data in this file.
EVIDENCEFORGE_ENVIRONMENT=development
EVIDENCEFORGE_LOG_LEVEL=INFO
EVIDENCEFORGE_API_HOST=127.0.0.1
EVIDENCEFORGE_API_PORT=8000
EVIDENCEFORGE_STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
EVIDENCEFORGE_DATABASE_URL=sqlite:///./evidenceforge.db
EVIDENCEFORGE_LLM_PROVIDER=mock
EVIDENCEFORGE_OPENAI_MODEL=gpt-5.6-sol
EVIDENCEFORGE_OPENAI_REASONING_ENABLED=true
EVIDENCEFORGE_OPENAI_REASONING_EFFORT=low
# EVIDENCEFORGE_OPENAI_API_KEY=replace-me
# EVIDENCEFORGE_NCBI_EMAIL=maintainer@example.com
# EVIDENCEFORGE_NCBI_API_KEY=replace-me
EVIDENCEFORGE_REQUEST_TIMEOUT_SECONDS=10
EVIDENCEFORGE_REQUEST_RETRIES=2
